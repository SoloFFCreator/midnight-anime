{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/share/series/:id",
      "destination": "/api/share-preview?kind=series&id=:id"
    },
    {
      "source": "/share/episode/:id/:episode",
      "destination": "/api/share-preview?kind=episode&id=:id&episode=:episode"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
