# This project currently has API keys inline in src/api/tmdb.js and
# src/api/firebase.js for parity with the single-file web app version.
# For production, move these into environment variables instead:
#
# VITE_TMDB_API_KEY=your_key_here
# VITE_FIREBASE_API_KEY=your_key_here
#
# Then reference them in code via import.meta.env.VITE_TMDB_API_KEY
